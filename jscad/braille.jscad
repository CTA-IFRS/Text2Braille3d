	"4" : 145,	//⠙
	"5" : 15,	//⠑
	"6" : 124,	//⠋
	"7" : 1245,	//⠛
	"8" : 125,	//⠓
	"9" : 24,	//⠊
	"0" : 245,	//⠚
	
	"ç" : 12346,  // 
	"é" : 123456,
	"á" : 12356,
	"è" : 2346,
	"ú" : 23456,
	"â" : 16,
	"ê" : 126,
	"ì" : 146,
	"ô" : 1456,
	"@" : 156,
	"à" : 1246,
	"ñ" : 12456,
	"ü" : 1256,
	"õ" : 246,
	"í" : 34,
	"ã" : 345,
	"ó" : 346,
	
	"&" : 12346,//⠯
	"%" : 123456,//⠿
	"[" : 12356,//⠷
	"]" : 23456,//⠾
	"`" : 1246,	//⠫
	"^" : 12456,//⠻
	"#" : 3456,	//⠼
	"$" : 46,	//⠨
	"." : 3,	//⠄
	"," : 2,	//⠂
