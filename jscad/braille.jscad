function log(text)
{
	if (OpenJsCad.log && debug)
		OpenJsCad.log(text);
}

function form_base()
{
	if (parameters.plate_thickness <= 0.0)
		return new CSG();
	
	var dimensions = [parameters.form_distance/2, parameters.line_height/2, parameters.plate_thickness/2];
	var offset = [parameters.form_distance/2, -parameters.line_height/2, -parameters.plate_thickness/2];
	
	return CSG.cube({ center: offset, radius: dimensions });
}

function rotateZ_extrude(obj2d, resolution)
{
	return obj2d.solidFromSlices({
		numslices: resolution,
		loop : true,
		callback: function(t, slice) {
			return this.rotateZ(360/resolution*slice);
		}
	});
}

function ring(radius1, radius2, resolution)
{	
	var points = new Array(resolution);
	for (var i=0; i<resolution; i++)
	{
		var t = i/resolution;
		var angle = Math.PI * 2 * t;
		var x = radius1 * Math.cos(angle);
		var z = radius1 * Math.sin(angle);
		points[i] = [x,0,z];
	}
	
	var circle = CSG.Polygon.createFromPoints(points).translate([radius2-radius1,0,0]);
	return rotateZ_extrude(circle, resolution);
}

function sized_dot()
{
	if (master_dot == null)
	{
		var dot;
		if (parameters.dot_shape == 'sphere')
		{
			dot = CSG.sphere({ center: [0, 0, 0], radius: 1, resolution: parameters.resolution });
			var sub = CSG.cube({ center: [0, 0, 0], radius: [1.25, 1.25, 1] }).translate([0, 0, -1.05]);
			dot = dot.subtract(sub);
		}
		else if (parameters.dot_shape == 'cylinder')
		{
			dot = CSG.cylinder({ start: [0, 0, -0.05], end: [0, 0, 1], radius: 1, resolution: parameters.resolution });
		}
		else if (parameters.dot_shape == 'smooth')
		{
			dot = CSG.sphere({ center: [0, 0, 1], radius: 1, resolution: parameters.resolution });
			dot = dot.scale([1, 1, 0.5]);
		}
		else
		{
			throw new Error("Unknown dot shape '" + parameters.dot_shape + "'");
		}
		
		dot = dot.scale([parameters.dot_diameter/2, parameters.dot_diameter/2, parameters.dot_height]);
		dot = dot.setColor(colorDot[0], colorDot[1], colorDot[2]);
		
		//final touch of 'smooth' is best done after scaling
		if (parameters.dot_shape == 'smooth')
		{
			var ringRadius1 = parameters.dot_height / 2;
			var ringRadius2 = parameters.dot_diameter/2 + parameters.dot_height;
			
			var base = CSG.cylinder({ start: [0, 0, -0.05], end: [0, 0, ringRadius1], radius: ringRadius2-ringRadius1, resolution: parameters.resolution });
			base = base.setColor(colorPlate[0], colorPlate[1], colorPlate[2]);
			var smoother = ring(ringRadius1, ringRadius2, parameters.resolution).translate([0, 0, ringRadius1]);
			smoother = smoother.setColor(colorPlate[0], colorPlate[1], colorPlate[2]);
			dot = dot.union(base).subtract(smoother);
		}
		
		master_dot = dot;
	}
	return CSG.fromObject(master_dot);
}

function dot(x, y)
{
	var x_pos = (parameters.form_distance - parameters.dot_distance) / 2 + (x-1) * parameters.dot_distance;
	var y_pos = -(parameters.line_height - parameters.dot_distance*2) / 2 - (y-1) * parameters.dot_distance;
	
	var the_dot = sized_dot();
	the_dot = the_dot.translate([x_pos, y_pos, 0]);
	
	return the_dot;
}

function characterByCode(charCode)
{
	var dotArray = [];
	
	while (charCode > 0)
	{
		var dotCode = (charCode % 10) - 1;
		charCode = Math.floor(charCode / 10);
		if (dotCode < 0)
			continue;
		
		dotArray.unshift([dotCode < 3 ? 1 : 2, (dotCode % 3) + 1]);
	}
	
	return characterByDots(dotArray);
}

function characterByDots(dots)
{
	var theCharacter = new Array(dots.length);
	
	for (var i=0; i < dots.length; i++)
	{
		theCharacter[i] = dot(dots[i][0], dots[i][1]);
	}
	
	return theCharacter;
}

function generate(text)
{
	log("generating:\n" + text);
	
	if (!parameters.upper)
		text = text.toLowerCase();
	
	var result = new CSG();
	if (text.length == 0)
		return result;
	
	var find;
	var replace;
	
	//we want uniform newlines for further processing!
	find = /\n\r|\r\n|\r/;
	replace = "\n";
	text = text.replace(/\r\n|\n\r|\r/g, replace);
	
	if (!parameters.straight)
	{
		//the regex unicode matching for uppercase letters (not supported in js):
		// var find = /([\p{Lu}])/g;
		// var replace = "$\L$1";
		
		//a WHOLE WORD in uppercase letters is prefaced by the character >
		//TODO: make this combinable with single uppercase letters!
		// find = /(\s|^)([A-ZÄÖÜ]+)(?=\s|$)/g;
		// replace = "$1>$2";
		// text = text.replace(find, replace).toLowerCase();
		
		//single uppercase letters are prefaced by the character $
		find = /([A-ZÄÖÜ])/g;
		replace = "$$$1";
		text = text.replace(find, replace).toLowerCase();
		
		//numbers are prefaced by the character #
		find = /([\d]+)/g;
		replace = "#$1";
		text = text.replace(find, replace);
		
		//is the number followed by a character between 'a' and 'j', a ' is inserted to avoid confusion
		find = /([\d])(?=[a-j])/g;
		replace = "$1'";
		text = text.replace(find, replace);
		
		//replace quotes with opening and closing quotes
		find = /"([^"]*)"/g;
		replace = "»$1«";
		// find = /(\s|^)"([^"]*)"(?=\s|$)/g;		//unsure about this
		// replace = "$1»$2«";
		text = text.replace(find, replace);
	}
	
	//take care of contractions. they are marked by underlines (_xy_), thus _ needs to be escaped (__)
	find = /(_)/g;
	replace = "$1$1";
	text = text.replace(find, replace);
	
	if (parameters.contractions)
	{
		find = /(st|au|eu|ei|sch|ch|äu|ie)/g;
		replace = "_$1_";
		text = text.replace(find, replace);
	}
	
	log("converting to:\n" + text);
	
	
	var numLines = 1;
	var textWidth = 0;
	var lineWidth = 0;
	
	var theCharacters = [];
	
	var offset = new CSG.Vector3D(parameters.plate_margin, -parameters.plate_margin, 0);
	
	var isMultiCharForm = false;
	var multiChars = "";
	
	for (var c=0; c < text.length; c++)
	{
		var newCharacter = text.charAt(c);
		
		var multiChar = newCharacter == '_';
		if (isMultiCharForm)
		{
			if (multiChar)
			{
				newCharacter = (multiChars.length == 0) ? "_" : multiChars;
				isMultiCharForm = false;
				multiChars = "";
			}
			else
			{
				multiChars += newCharacter;
				continue;
			}
		}
		else if (multiChar)
		{
			isMultiCharForm = true;
			continue;
		}
		else if (newCharacter == "\n")
		{
			numLines++;
			lineWidth = 0;
			log("\n");
			continue;
		}
		
		lineWidth++;
		
		var charCode = characters[newCharacter];
		
		if (typeof charCode == "undefined")
		{
			charCode = characters["?"];
			throw new Error("text: caractere não suportado '" + newCharacter + "'.");
		}
		
		if (charCode > 0)
			textWidth = Math.max(textWidth, lineWidth);
		
		var characterDots = characterByCode(charCode);
		var position = offset.plus(new CSG.Vector3D(parameters.form_distance * (lineWidth-1), parameters.line_height * -(numLines-1), 0));
		for (var cp=0; cp < characterDots.length; cp++)
			characterDots[cp] = characterDots[cp].translate([position.x, position.y, position.z]);
		
		theCharacters = theCharacters.concat(characterDots);
		
		log(newCharacter);
	}
	
	var layout = composePlate(textWidth, numLines, theCharacters);
	result = layout.base.union(layout.rawDots).union(layout.text);
	
	if (parameters.reference_corner && parameters.plate_margin > 0)
	{
		var cornerCut = CSG.cube({ center: [0, 0, 0], radius: [parameters.plate_margin, parameters.plate_margin/2, parameters.plate_thickness] }).rotateZ(45);
		cornerCut = cornerCut.setColor(colorInside[0], colorInside[1], colorInside[2]);
		result = result.subtract(cornerCut);
		layout.base = layout.base.subtract(cornerCut);
	}
	
	var dimensions = layout.dimensions;
	result = result.translate([-dimensions[0]/2, dimensions[1], 0]).rotateX(90);
	function transformPart(solid) { return solid.translate([-dimensions[0]/2, dimensions[1], 0]).rotateX(90); }
	layout.base = transformPart(layout.base);
	layout.dots = transformPart(layout.dots);
	layout.text = transformPart(layout.text);
	
	if (parameters.stands)
	{
		var standDiameter = 10.0;
		var standHeight = 0.3;
		var bounds = result.getBounds();
		var standCircle = CSG.cylinder({ start: [0, 0, 0], end: [0, 0, standHeight], radius: standDiameter/2, resolution: parameters.resolution });
		var stand = CSG.cube({ center: [0, parameters.plate_thickness/2, standHeight/2], radius: [bounds[1].x + standDiameter/2, parameters.plate_thickness/2, standHeight/2] });
		stand = stand.union(standCircle.translate([bounds[0].x - standDiameter/2, parameters.plate_thickness/2, 0]));
		stand = stand.union(standCircle.translate([bounds[1].x + standDiameter/2, parameters.plate_thickness/2, 0]));
		stand = stand.setColor(colorSupport[0], colorSupport[1], colorSupport[2]);
		
		result = result.union(stand);
		layout.base = layout.base.union(stand);
	}
	result.parts = [{name: 'base', data: layout.base}, {name: 'dots', data: layout.dots}];
	if (layout.text.polygons.length) result.parts.push({name: 'text', data: layout.text});
	result.plateInfo = {dimensions: dimensions, brailleCells: textWidth, brailleLines: numLines};
	
	return result;
}



function getParameterDefinitions()
{
	var debug = false;
	
	var parameterDefinitions = [
		{ name: 'text', caption: 'Texto', type: 'longtext', initial: 'Olá Mundo' },
		{ name: 'upper', caption: 'Maiúsculo', type: 'bool', initial: false },
		{ name: 'contractions', caption: 'Contrações', type: 'bool', initial: false, visible: false },
		{ name: 'straight', caption: 'Conversão direta', type: 'bool', initial: false, visible: false },
	
		{ name: 'form_size', caption: 'Tamanho do formulário [0mm - 10mm]', type: 'float', initial: 5.0, visible: false },
	    { name: 'dot_distance', caption: 'Distância entre pontos [default: 2.7mm]:', type: 'float', initial: 2.7, begin: 1.6, end: 2.7, step: 0.01, visible: false},
		//  { name: 'form_distance', caption: 'Form-Abstand', type: 'float', initial: 6.6},
		//  { name: 'line_height', caption: 'Zeilen-Höhe', type: 'float', initial: 10.8, visible: false },
	  	{ name: 'dot_height', caption: 'Altura do ponto [default: 0.75mm]:', type: 'range', initial: 0.75,  begin: 0.6, end: 0.8, step: 0.01},
		{ name: 'dot_diameter', caption: 'Diâmetro do ponto [default: 1.9mm]:', type: 'range', initial: 1.9, begin: 1.2, end: 2.0, step: 0.01 },
	
		{ name: 'plate_thickness', caption: 'Espessura da placa (mm):', type: 'float', initial: 2.0 },
		{ name: 'plate_margin', caption: 'Margem da placa (mm):', type: 'float', initial: 5.0 },
	
		{ name: 'reference_corner', caption: 'Gerar canto de referência ?', type: 'bool', initial: true },
		{ name: 'stands', caption: 'Gerar apoios para impressão ?', type: 'bool', initial: true },

		{ name: 'resolution', caption: 'Resolução', type: 'int', initial: 16, visible: false },
		{ name: 'dot_shape', caption: 'Formato do ponto', type: 'choice', values: ['sphere', 'cylinder', 'smooth'], captions: ['Esfera', 'Cilindro', 'Plano'], initial: 'smooth' , visible: false },
		//{ name: 'debug_dot', caption: 'Debug dot', type: 'bool', initial: false, visible: debug }
	];
	
	var definitions = parameterDefinitions.concat(plateFeatureDefinitions());
	var limits = {plate_margin:[0,100],plate_thickness:[0.2,50],letter_size:[2,30],letter_relief:[0.1,5],letter_gap:[0,50],ear_position:[0,1],ear_width:[4,100],ear_height:[4,100],ear_hole:[1,50],ear_thickness:[0.2,50],ear_overlap:[0.2,10],screw_clearance:[0,3],screw_edge:[0.5,100],screw_head_diameter:[3.1,30],screw_head_depth:[0.1,49.8]};
	definitions.forEach(function(def) {if(limits[def.name]) {def.min=limits[def.name][0];def.max=limits[def.name][1];}});
	return definitions;
}

function plateFeatureDefinitions() {
	return [
		{name:'visual_text',caption:'Mostrar texto visual acima do Braille',type:'bool',initial:false},
		{name:'letter_size',caption:'Altura da caixa alta das letras (mm)',type:'float',initial:6},
		{name:'letter_relief',caption:'Altura do relevo (mm)',type:'float',initial:0.8},
		{name:'letter_align',caption:'Alinhamento',type:'choice',values:['left','center','right'],captions:['Esquerda','Centro','Direita'],initial:'left'},
		{name:'letter_gap',caption:'Distância entre letras e Braille (mm)',type:'float',initial:3},
		{name:'ear_enabled',caption:'Orelha para chaveiro',type:'bool',initial:false},
		{name:'ear_side',caption:'Lado da orelha',type:'choice',values:['left','right','top','bottom'],captions:['Esquerda','Direita','Superior','Inferior'],initial:'right'},
		{name:'ear_position',caption:'Posição no lado (0 a 1)',type:'float',initial:0.5},
		{name:'ear_width',caption:'Largura da orelha ao longo da borda (mm)',type:'float',initial:12},
		{name:'ear_height',caption:'Projeção externa da orelha (mm)',type:'float',initial:12},
		{name:'ear_hole',caption:'Diâmetro do furo da orelha (mm)',type:'float',initial:5},
		{name:'ear_thickness',caption:'Espessura da orelha (mm)',type:'float',initial:2},
		{name:'ear_overlap',caption:'Reforço: sobreposição da ligação (mm)',type:'float',initial:1},
		{name:'ear_chamfer_enabled',caption:'Chanfrar cantos externos da orelha',type:'bool',initial:false},
		{name:'ear_chamfer',caption:'Chanfro externo a 45° (mm)',type:'range',initial:1,begin:0,end:10,step:0.1,min:0,max:10},
		{name:'ear_joint_chamfer_enabled',caption:'Reforçar cantos internos da junção',type:'bool',initial:false},
		{name:'ear_joint_chamfer',caption:'Chanfro de reforço da junção a 45° (mm)',type:'range',initial:2,begin:0,end:10,step:0.1,min:0,max:10},
		{name:'screws_enabled',caption:'Furos para parafusos',type:'bool',initial:false},
		{name:'screw_size',caption:'Diâmetro nominal',type:'choice',values:['M2','M3','M4','M5','M6'],captions:['M2 (2 mm)','M3 (3 mm)','M4 (4 mm)','M5 (5 mm)','M6 (6 mm)'],initial:'M3'},
		{name:'screw_clearance',caption:'Folga diametral do furo (mm)',type:'float',initial:0.4},
		{name:'screw_count',caption:'Quantidade de furos',type:'choice',values:['2','4'],captions:['2: diagonais opostas','4: quatro cantos'],initial:'2'},
		{name:'screw_layout',caption:'Posi\u00e7\u00e3o dos furos',type:'choice',values:['top','center','bottom','diagonal_left','diagonal_right','corners'],captions:['Superior','Centro das laterais','Inferior','Diagonal esquerda','Diagonal direita','Quatro cantos'],initial:'diagonal_left'},
		{name:'screw_edge',caption:'Centro dos furos até as bordas (mm)',type:'float',initial:5},
		{name:'screw_head',caption:'Alojamento da cabeça',type:'choice',values:['none','counterbore','countersink'],captions:['Sem alojamento','Rebaixo cilíndrico','Escareado'],initial:'none'},
		{name:'screw_head_diameter',caption:'Diâmetro da cabeça (mm)',type:'float',initial:6},
		{name:'screw_head_depth',caption:'Profundidade da cabeça (mm)',type:'float',initial:1}
	];
}

function requireRange(name, min, max) {
	var value = Number(parameters[name]);
	if (!isFinite(value) || value < min || value > max) throw new Error('Valor inválido em '+name+': use '+min+' a '+max+'.');
	parameters[name] = value;
}

function validatePlateParameters() {
	parameters.text = String(parameters.text).replace(/\r\n|\n\r|\r/g,'\n');
	if (!parameters.text.trim()) throw new Error('text: digite pelo menos um caractere diferente de espaço.');
	requireRange('plate_margin',0,100);
	requireRange('plate_thickness',0.2,50);
	requireRange('dot_height',0.05,10); requireRange('dot_diameter',0.1,10);
	requireRange('dot_distance',0.1,20); requireRange('form_size',0,10); requireRange('resolution',8,96);
	if (parameters.visual_text) {
		requireRange('letter_size',2,30); requireRange('letter_relief',0.1,5); requireRange('letter_gap',0,50);
		if (['left','center','right'].indexOf(parameters.letter_align)<0) throw new Error('Alinhamento inválido.');
	}
	if (parameters.ear_enabled) {
		requireRange('ear_position',0,1); requireRange('ear_width',4,100); requireRange('ear_height',4,100);
		requireRange('ear_hole',1,50); requireRange('ear_thickness',0.2,parameters.plate_thickness);
		requireRange('ear_overlap',0.2,10);
		if(parameters.ear_chamfer_enabled) requireRange('ear_chamfer',0,10);
		if(parameters.ear_joint_chamfer_enabled) requireRange('ear_joint_chamfer',0,10);
		if (['left','right','top','bottom'].indexOf(parameters.ear_side)<0) throw new Error('Lado da orelha inválido.');
		if (parameters.ear_hole >= Math.min(parameters.ear_width,parameters.ear_height)-1) throw new Error('ear_hole: o furo precisa manter parede maior que 0,5 mm.');
	}
	if (parameters.screws_enabled) {
		var screwCount=String(parameters.screw_count), screwLayouts=screwCount==='4'?['corners']:['top','center','bottom','diagonal_left','diagonal_right'];
		if (['M2','M3','M4','M5','M6'].indexOf(parameters.screw_size)<0 || ['2','4'].indexOf(screwCount)<0 || screwLayouts.indexOf(parameters.screw_layout)<0) throw new Error('Escolha M2, M3, M4, M5 ou M6, 2/4 furos e uma posi\u00e7\u00e3o compat\u00edvel com a quantidade.');
		requireRange('screw_clearance',0,3); requireRange('screw_edge',0.5,100);
		if (['none','counterbore','countersink'].indexOf(parameters.screw_head)<0) throw new Error('Alojamento inválido.');
		if (parameters.screw_head!=='none') {
			requireRange('screw_head_diameter',Number(parameters.screw_size.slice(1))+parameters.screw_clearance+0.1,30);
			requireRange('screw_head_depth',0.1,parameters.plate_thickness-0.2);
		}
	}
}

function plateBox(x0,y0,x1,y1,z0,z1) {
	return CSG.cube({center:[(x0+x1)/2,(y0+y1)/2,(z0+z1)/2],radius:[(x1-x0)/2,(y1-y0)/2,(z1-z0)/2]});
}

function visualLetters() {
	var scale = parameters.letter_size / letterFontCapHeight;
	var visualText = parameters.upper ? parameters.text.toUpperCase() : parameters.text;
	var lines = visualText.split('\n'), lineSolids=[], maxWidth=0;
	lines.forEach(function(line,index) {
		var cursor=0, glyphSolids=[];
		for(var i=0;i<line.length;i++) {
			var glyph=letterFontContours[line.charAt(i)];
			if (!glyph) throw new Error('text: caractere sem contorno visual: '+line.charAt(i));
			var outer=new CAG(), holes=[];
			glyph.contours.forEach(function(contour) {
				var area=0;
				for(var j=0;j<contour.length;j++) { var a=contour[j],b=contour[(j+1)%contour.length]; area+=a[0]*b[1]-b[0]*a[1]; }
				var shape=CAG.fromPoints(contour.map(function(p){return [p[0]*scale,p[1]*scale];}));
				if(area<0) outer=outer.union(shape); else holes.push(shape);
			});
			holes.forEach(function(hole) {outer=outer.subtract(hole);});
			if(outer.sides.length) glyphSolids.push(outer.extrude({offset:[0,0,parameters.letter_relief]}).translate([cursor*scale,0,0]));
			cursor+=glyph.advance;
		}
		if(glyphSolids.length) {
			var solid=new CSG().union(glyphSolids);
			var bounds=solid.getBounds();
			solid=solid.translate([-bounds[0].x,-bounds[1].y-index*parameters.letter_size*1.5,0]);
			var width=bounds[1].x-bounds[0].x; maxWidth=Math.max(maxWidth,width);
			lineSolids.push({solid:solid,width:width});
		}
	});
	return {lines:lineSolids,width:maxWidth};
}

function composePlate(cells,lines,dots) {
	var margin=parameters.plate_margin, bw=cells*parameters.form_distance, bh=lines*parameters.line_height;
	var visual=parameters.visual_text ? visualLetters():{lines:[],width:0};
	var contentWidth=Math.max(bw,visual.width), textSolid=new CSG();
	visual.lines.forEach(function(line) {
		var dx=parameters.letter_align==='right'?contentWidth-line.width:parameters.letter_align==='center'?(contentWidth-line.width)/2:0;
		textSolid=textSolid.union(line.solid.translate([margin+dx,-margin,0]));
	});
	var shift=0;
	if(textSolid.polygons.length) {
		var vb=textSolid.getBounds();
		// Gap is measured between the actual text and Braille polygon limits.
		var raw=new CSG().union(dots), db=raw.getBounds();
		shift=db[1].y-vb[0].y+parameters.letter_gap;
	}
	var width=contentWidth+2*margin,height=bh+2*margin+shift;
	var rawDots=new CSG().union(dots).translate([0,-shift,0]);
	var base=plateBox(0,-height,width,0,-parameters.plate_thickness,0).setColor(colorPlate[0],colorPlate[1],colorPlate[2]);
	var text=textSolid.setColor(colorDot[0],colorDot[1],colorDot[2]);
	var content=rawDots.union(text);
	var cornerCut=parameters.reference_corner&&margin>0 ? CSG.cube({center:[0,0,0],radius:[margin,margin/2,parameters.plate_thickness]}).rotateZ(45):null;
	var ear=null;
	if(parameters.ear_enabled) {
		var side=parameters.ear_side, along=(side==='left'||side==='right')?height:width;
		var ew=parameters.ear_width, eh=parameters.ear_height, overlap=parameters.ear_overlap;
		if(ew>along) throw new Error('ear_width: largura excede o lado escolhido.');
		var pos=ew/2+parameters.ear_position*(along-ew), cx,cy;
		if(side==='left'||side==='right') {
			cx=side==='left'?-eh/2:width+eh/2; cy=-pos;
			ear=plateBox(side==='left'?-eh:width-overlap,cy-ew/2,side==='left'?overlap:width+eh,cy+ew/2,-parameters.ear_thickness,0);
		} else {
			cx=pos;cy=side==='top'?eh/2:-height-eh/2;
			ear=plateBox(cx-ew/2,side==='top'?-overlap:-height-eh,cx+ew/2,side==='top'?eh:-height+overlap,-parameters.ear_thickness,0);
		}
		// Local coordinates: u runs along the plate edge; v points outwards.
		// These 45-degree chamfers affect the outline through the ear thickness.
		function earTriangle(points) {
			return CAG.fromPoints(points.map(function(p) {
				if(side==='right') return [width+p[1],cy+p[0]];
				if(side==='left') return [-p[1],cy+p[0]];
				if(side==='top') return [cx+p[0],p[1]];
				return [cx+p[0],-height-p[1]];
			})).extrude({offset:[0,0,parameters.ear_thickness]}).translate([0,0,-parameters.ear_thickness]);
		}
		var chamfer=parameters.ear_chamfer_enabled?parameters.ear_chamfer:0;
		if(chamfer>0) {
			if(chamfer>=Math.min(ew/2,eh/2)) throw new Error('ear_chamfer: use valor menor que metade da largura e da projeção da orelha.');
			for(var direction=-1;direction<=1;direction+=2) {
				var cutter=earTriangle([[direction*ew/2,eh],[direction*(ew/2-chamfer),eh],[direction*ew/2,eh-chamfer]]);
				// Reserve a 0.5 mm wall around the hole before removing material.
				var wall=CSG.cylinder({start:[cx,cy,-parameters.ear_thickness-1],end:[cx,cy,1],radius:parameters.ear_hole/2+0.5,resolution:parameters.resolution});
				if(cutter.intersect(wall).polygons.length) throw new Error('ear_chamfer: chanfro deixa parede insuficiente junto ao furo.');
				ear=ear.subtract(cutter);
			}
		}
		var joint=parameters.ear_joint_chamfer_enabled?parameters.ear_joint_chamfer:0;
		if(joint>0) {
			if(joint>=eh || pos-ew/2-joint<0 || pos+ew/2+joint>along) throw new Error('ear_joint_chamfer: reforço excede o lado da placa ou a projeção da orelha; reduza o valor ou ajuste posição.');
			for(var direction=-1;direction<=1;direction+=2) {
				ear=ear.union(earTriangle([[direction*ew/2,0],[direction*(ew/2+joint),0],[direction*ew/2,joint]]));
			}
		}
		var hole=CSG.cylinder({start:[cx,cy,-parameters.plate_thickness-1],end:[cx,cy,1],radius:parameters.ear_hole/2,resolution:parameters.resolution});
		ear=ear.subtract(hole);
		if(ear.intersect(content).polygons.length) throw new Error('ear_overlap: ligação invade texto/Braille; aumente plate_margin ou reduza o reforço.');
		if(parameters.stands && (side==='bottom'||(side==='left'||side==='right') && pos+ew/2>height-0.3)) throw new Error('ear_side: orelha e stands colidem; mude lado/posição ou desative apoios.');
		if(cornerCut && ear.intersect(cornerCut).polygons.length) throw new Error('ear_position: orelha colide com reference_corner; mude posição ou desative o canto.');
		ear=ear.setColor(colorPlate[0],colorPlate[1],colorPlate[2]);
		base=base.union(ear);
	}
	if(parameters.screws_enabled) {
		var edge=parameters.screw_edge, r=(Number(parameters.screw_size.slice(1))+parameters.screw_clearance)/2;
		var hr=parameters.screw_head==='none'?r:parameters.screw_head_diameter/2;
		if(edge<=hr || width<=2*edge+2*hr || height<=2*edge+2*hr) throw new Error('screw_edge: furos sem parede positiva ou placa pequena; ajuste distância às bordas/margens.');
		var centers, layout=parameters.screw_layout;
		// screw_edge sets the distance from each hole center to its nearest plate edge.
		if(layout==='center') {
			centers=[[edge,-height/2],[width-edge,-height/2]];
		} else if(layout==='top') {
			centers=[[edge,-edge],[width-edge,-edge]];
		} else if(layout==='bottom') {
			centers=[[edge,-height+edge],[width-edge,-height+edge]];
		} else if(layout==='diagonal_right') {
			centers=[[width-edge,-edge],[edge,-height+edge]];
		} else if(layout==='corners') {
			centers=[[edge,-edge],[width-edge,-edge],[width-edge,-height+edge],[edge,-height+edge]];
		} else { // diagonal_left; mant\u00e9m as coordenadas anteriores.
			centers=[[edge,-edge],[width-edge,-height+edge]];
		}

		centers.forEach(function(c) {
			var keepout=CSG.cylinder({start:[c[0],c[1],-parameters.plate_thickness-1],end:[c[0],c[1],10],radius:hr,resolution:parameters.resolution});
			if(keepout.intersect(content).polygons.length) throw new Error('screw_edge: furo invade texto/Braille; aumente plate_margin ou ajuste distância às bordas.');
			if(ear && keepout.intersect(ear).polygons.length) throw new Error('screw_edge: furo colide com ligação da orelha.');
			if(cornerCut && keepout.intersect(cornerCut).polygons.length) throw new Error('screw_edge: furo colide com reference_corner.');
			var cut=CSG.cylinder({start:[c[0],c[1],-parameters.plate_thickness-1],end:[c[0],c[1],1],radius:r,resolution:parameters.resolution});
			if(parameters.screw_head!=='none') cut=cut.union(CSG.cylinder({start:[c[0],c[1],-parameters.screw_head_depth],end:[c[0],c[1],0.001],radiusStart:parameters.screw_head==='countersink'?r:hr,radiusEnd:hr,resolution:parameters.resolution}));
			base=base.subtract(cut);
		});
	}
	// Separate parts at z=0: shared contact surfaces, no volumetric overlap.
	var clippedDots=rawDots.subtract(plateBox(-10000,-10000,10000,10000,-10000,0));
	return {base:base,dots:clippedDots,rawDots:rawDots,text:text,dimensions:[width,height]};
}

function main(params)
{
	log("start");
	
	parameters = {};
	getParameterDefinitions().forEach(function(def) { parameters[def.name] = def.initial; });
	Object.keys(params).forEach(function(key) { parameters[key] = params[key]; });
	validatePlateParameters();
	master_dot = null;
	
	var formFactor = parameters.form_size / 10.0;
	parameters.dot_distance = parameters.dot_distance + 0.7 * formFactor;
	parameters.form_distance = parameters.dot_distance * 2.5;
	parameters.line_height = parameters.dot_distance * 4.0;
	
	var result;
	if (parameters.debug_dot)
		result = sized_dot().scale([3, 3, 3]);
	else
		result = generate(parameters.text);
	
	log("finish");
	
	return result;
}

